# Copy this file to `.env` to override the defaults used by docker-compose.yml.
# `.env` is git-ignored; this template is the only tracked copy.
#
# These are local, learning-environment credentials. Use your own values
# (and a secrets manager) for anything that is not running on your machine.
#
# Note: PostgreSQL applies these values only when the database volume is first
# created. After changing them, reset the volume: `docker compose down -v`.

POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=mlops_password
POSTGRES_DB=mlops_db
